: 1:0;gpg --armor --export email@pm.me > my-key.asc
: 2:0;gpg --fingerprint email@pm.me
: 3:0;gpg --decrypt
: 4:0;gpg --show-keys
: 5:0;gpg --import
: 6:0;gpg --encrypt --armor --recipient user hi.md
: 7:0;oxipng -o max --strip safe img.png
: 8:0;ffmpeg -i vi.mp4 -vcodec libx264 -crf 28 -acodec aac -b:a 128k vi.mp4
: 9:0;jpegoptim --max=70 --strip-all *.jpg
